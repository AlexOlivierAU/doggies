QMainWindow, QDialog, QWidget {
  background: #121212;
  color: #e8e8e8;
  font-size: 13px;
}
QWidget {
  font-family: "IBM Plex Sans", "Segoe UI", "Helvetica Neue", sans-serif;
}
QListWidget {
  background: #161616;
  border: none;
  border-right: 1px solid #2c2c2c;
  padding: 8px 0;
  outline: none;
}
QListWidget::item {
  padding: 10px 16px;
  color: #c5c5c5;
}
QListWidget::item:selected {
  background: #2a2a2a;
  color: #ffffff;
  font-weight: 600;
}
QToolBar {
  background: #161616;
  border-bottom: 1px solid #2c2c2c;
  spacing: 8px;
  padding: 4px 8px;
}
QStatusBar {
  background: #161616;
  color: #9aa0a6;
  border-top: 1px solid #2c2c2c;
}
QLabel#kicker {
  color: #9aa0a6;
  font-size: 11px;
  letter-spacing: 0.06em;
}
QLabel#heroTitle {
  font-size: 22px;
  font-weight: 700;
}
QLabel#pickLine {
  font-size: 16px;
  font-weight: 650;
}
QFrame#heroCard, QFrame#statCard, QFrame#panel {
  background: #1a1a1a;
  border: 1px solid #2f2f2f;
  padding: 8px;
}
QTableView {
  background: #161616;
  alternate-background-color: #1c1c1c;
  gridline-color: #2a2a2a;
  selection-background-color: #2f3a4a;
  selection-color: #ffffff;
  border: 1px solid #2c2c2c;
}
QHeaderView::section {
  background: #1c1c1c;
  color: #b0b0b0;
  padding: 6px 8px;
  border: none;
  border-right: 1px solid #2a2a2a;
  border-bottom: 1px solid #2a2a2a;
  font-weight: 600;
}
QPushButton {
  background: #2a2a2a;
  color: #e8e8e8;
  border: 1px solid #3d3d3d;
  padding: 6px 12px;
  min-height: 24px;
}
QPushButton:hover {
  background: #333333;
}
QPushButton:disabled {
  color: #777777;
}
QPushButton#primaryButton {
  background: #3d5a3d;
  border-color: #4e7a4e;
}
QComboBox, QDateEdit, QSpinBox, QLineEdit, QCheckBox {
  background: #1e1e1e;
  color: #e8e8e8;
  border: 1px solid #3d3d3d;
  padding: 4px 6px;
  min-height: 22px;
}
QTextEdit, QPlainTextEdit {
  background: #161616;
  color: #d8d8d8;
  border: 1px solid #2c2c2c;
}
QScrollArea {
  border: none;
}
QLabel#healthOk { color: #2e7d32; font-weight: 650; }
QLabel#healthWarn { color: #ef6c00; font-weight: 650; }
QLabel#healthErr { color: #c62828; font-weight: 650; }
QLabel#muted { color: #9aa0a6; }
QLabel#warn { color: #ef6c00; font-weight: 650; }
